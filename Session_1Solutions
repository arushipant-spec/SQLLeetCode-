// 1280.Students and Examinsations
WITH Base_tab AS 
    (SELECT * 
    FROM Students S 
    CROSS JOIN Subjects Sub)
SELECT b.student_id
    ,b.student_name
    ,b.subject_name
    ,count(E.subject_name) as attended_exams
FROM base_tab as b 
LEFT JOIN Examinations as E 
ON b.student_id = E.student_id 
AND b.subject_name = E.subject_name
GROUP BY student_id, student_name, b.subject_name
ORDER BY student_id, subject_name ASC








